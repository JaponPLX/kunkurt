# ==============================================================================
# CONFIGURACIÓN DINÁMICA DE ENTORNO (KUNKURT DEVS)
# Ninguna ruta ni puerto está hardcodeado. Puedes sobreescribir cualquier variable.
# ==============================================================================

# Puerto y host del servidor web (por defecto busca 8080 o el primer puerto libre)
PORT=8080
HOST=0.0.0.0

# Rutas del sistema (por defecto se calculan automáticamente relativas a la carpeta)
# KUNKURT_BASE_DIR=/ruta/personalizada
# KUNKURT_STATIC_DIR=/ruta/personalizada/static
# KUNKURT_DB_PATH=/ruta/personalizada/kunkurt.db
# KUNKURT_UPLOADS_DIR=/ruta/personalizada/uploads
# KUNKURT_EMAIL_LOG=/ruta/personalizada/.email_notifications.log

# Configuración SMTP real (opcional: si no se configuran, las alertas se auditan en .email_notifications.log)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASSWORD=tu_contraseña_de_aplicacion
